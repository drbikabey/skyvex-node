# ============================================
# SkyVex NODE (sistem.py) - ortam değişkenleri
# Bu dosyayı .env olarak kopyalayıp doldur.
# GitHub'a .env dosyasını ASLA atma!
# ============================================

# --- Master panel ---
MASTER_PANEL_URL=http://skyvex.duckdns.org:15576
NODE_SECRET=skyvex_secret_123
NODE_NAME=SkyVex-Node-1
HEARTBEAT_INTERVAL=30

# --- Node HTTP API portu (master /exec buraya bağlanır) ---
PORT=7860

# --- Node'un dışarıdan erişilebilir adresi ---
# VPS ise:   http://VPS_IP:7860
# Render/Railway ise: https://siten.onrender.com
PUBLIC_URL=

# --- Tünel modu: fixed | bore | playit | auto ---
# fixed  = sabit IP/port (VPS için önerilir)
# bore   = public IP yoksa hem node API'sini hem sunucuları bore ile dışarı açar
# playit = node API'si için playit tunnel (deneysel)
# auto   = PUBLIC_URL yoksa bore ile API tüneli açar (GitHub Actions için ideal)
TUNNEL_MODE=auto

# --- Sabit IP/Port (TUNNEL_MODE=fixed için) ---
FIXED_IP=
FIXED_PORT=25565

# --- Playit (opsiyonel) ---
PLAYIT_TOKEN=
# PLAYIT_DOWNLOAD_URL boş bırakılırsa otomatik seçilir

# --- Minecraft ---
SERVER_JAR=server.jar
SERVER_RAM=2G
# İstersen node açılırken "default" adında bir sunucu başlatır (genelde false)
START_MC_SERVER=false
